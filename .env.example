# Copy this file to .env and fill it in.  NEVER commit .env to GitHub.

# Your Groq API key: https://console.groq.com/keys  (free tier available)
GROQ_API_KEY=gsk_REPLACE_ME
# Good defaults. Faster/lighter option: llama-3.1-8b-instant
LLM_MODEL=llama-3.3-70b-versatile

# ---- only needed on the AWS server ----
# e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REGISTRY=
AWS_REGION=us-east-1

# ---- optional: free HTTPS (strongly recommended before you sign in to any site) ----
# 1) uncomment the 3 lines below  2) use your domain, or <ip-with-dashes>.sslip.io (see README)
# COMPOSE_PROFILES=https
# DOMAIN=3-90-12-45.sslip.io
# FRONTEND_PORT_MAP=127.0.0.1:8080:80
